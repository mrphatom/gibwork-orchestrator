{
  "name": "gibwork-orchestrator",
  "version": "1.0.0",
  "description": "Enterprise-grade internal bounty orchestrator for engineering teams. Create, manage, review and approve Gibwork bounties from CLI and config. Coordinates with gibwork-github-bounty and gibwork-agent.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gibwork-orchestrator": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["gibwork", "orchestrator", "bounty", "solana", "team", "cli", "workflow"],
  "author": "mrphatom",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "dependencies": {
    "@gibwork/sdk": "^0.1.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
